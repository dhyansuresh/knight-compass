<resources>
<style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/orange</item><item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">@color/canvas</item><item name="android:navigationBarColor">@color/canvas</item><item name="android:windowLightNavigationBar">true</item><item name="android:windowBackground">@color/canvas</item><item name="android:windowActionModeOverlay">true</item></style>
<style name="Body"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/ink</item><item name="android:textSize">15sp</item></style>
<style name="Action"><item name="android:layout_width">match_parent</item><item name="android:layout_height">54dp</item><item name="android:background">@drawable/button_orange</item><item name="android:backgroundTint">@null</item><item name="android:textColor">#FFFFFF</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item></style>
<style name="Outline" parent="Action"><item name="android:background">@drawable/card</item><item name="android:textColor">@color/ink</item><item name="android:gravity">center_vertical</item><item name="android:paddingLeft">16dp</item></style>
</resources>
