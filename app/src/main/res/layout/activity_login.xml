<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/canvas"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical" android:background="@color/dark"><Button android:id="@+id/back" style="@style/Action" android:text="‹  Back to Home" android:layout_width="160dp" android:layout_height="48dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Knight Compass" android:textColor="#FFFFFF" android:textSize="29sp" android:textStyle="bold"/><ImageView android:layout_width="62dp" android:layout_height="62dp" android:src="@drawable/ic_compass" android:contentDescription="Knight Compass emblem"/></LinearLayout><TextView style="@style/Body" android:text="Your campus. Your next discovery." android:textColor="#C8E2FF" android:layout_marginTop="8dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="20dp" android:padding="22dp" android:orientation="vertical" android:background="@drawable/card">
<TextView style="@style/Body" android:text="Welcome back" android:textSize="26sp" android:textStyle="bold"/><TextView style="@style/Body" android:text="Log in to your Knight Compass account." android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:textColor="@color/muted"/>
<TextView style="@style/Body" android:text="Email" />
<EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="52dp" android:hint="knight@ucf.edu" android:inputType="textEmailAddress" android:singleLine="true" android:textSize="16sp"/>
<TextView style="@style/Body" android:text="Password" android:layout_marginTop="16dp"/>
<EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Enter your password" android:inputType="textPassword" android:singleLine="true" android:textSize="16sp"/>
<Button android:id="@+id/submit" style="@style/Action" android:text="Login" android:layout_marginTop="24dp"/>
<TextView style="@style/Body" android:text="New here? Create Account" android:gravity="center" android:layout_marginTop="24dp"/>
<TextView style="@style/Body" android:text="Explore campus events with Knight Compass." android:gravity="center" android:layout_marginTop="20dp" android:textSize="12sp" android:textColor="@color/muted"/>
</LinearLayout></LinearLayout></ScrollView>